<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Webb.log - Home</title>
    <link rel="stylesheet" href="/styles/layout.css" />
    <link rel="stylesheet" href="/styles/content.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-danger bg-opacity-25">
    <div class="container">
      <h1>Start Webb.loggin!</h1>
      <div class="container mt-5">
        <h5></h5>

        <input
          type="text"
          id="filename"
          placeholder="Nombre del archivo"
          class="form-control mb-3"
          required
        />
        <textarea
          id="content"
          rows="10"
          class="form-control mb-3"
          placeholder="Contenido del archivo..."
        ></textarea>

        <button class="btn btn-success" onclick="saveFile()">
          Guardar archivo
        </button>
        <div id="status" class="mt-3"></div>
        <h3 class="mt-4">Your blogs</h3>
        <div id="fileList" class="list-group mt-2"></div>
        <script>
          async function saveFile() {
            const filename = document.getElementById("filename").value;
            const content = document.getElementById("content").value;

            const res = await fetch("/save-file", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ filename, content }),
            });

            const msg = await res.text();
            const status = document.getElementById("status");
            status.innerHTML = `
  <div class="alert alert-info">${msg}</div>
`;

            setTimeout(() => {
              status.innerHTML = "";
            }, 3000);

            loadFiles();
          }

          async function loadFiles() {
            const res = await fetch("/files");
            const files = await res.json();

            const list = document.getElementById("fileList");
            list.innerHTML = "";

            files.forEach((file) => {
              const item = document.createElement("div");
              item.className =
                "list-group-item d-flex justify-content-between align-items-center";

              const fileLink = document.createElement("a");
              fileLink.href = "#";
              fileLink.className = "text-decoration-none flex-grow-1";
              fileLink.innerHTML = `📄 ${file}`;
              fileLink.onclick = () => loadFile(file);

              const deleteBtn = document.createElement("button");
              deleteBtn.className = "btn btn-sm btn-outline-danger ms-3";
              deleteBtn.innerHTML = "🗑️";
              deleteBtn.onclick = () => deleteFile(file);

              item.appendChild(fileLink);
              item.appendChild(deleteBtn);
              list.appendChild(item);
            });
          }
          async function deleteFile(filename) {
            if (!confirm(`¿Eliminar el archivo "${filename}"?`)) return;

            const res = await fetch(`/file/${filename}`, {
              method: "DELETE",
            });

            const msg = await res.text();
            const status = document.getElementById("status");
            status.innerHTML = `
  <div class="alert alert-warning">${msg}</div>
`;

            setTimeout(() => {
              status.innerHTML = "";
            }, 3000);

            loadFiles();
          }

          async function loadFile(filename) {
            const res = await fetch(`/file/${filename}`);
            const data = await res.json();

            document.getElementById("filename").value = filename;
            document.getElementById("content").value = data.content;
          }

          window.onload = loadFiles;
        </script>
      </div>
    </div>
    <script src="script.js"></script>
  </body>
</html>

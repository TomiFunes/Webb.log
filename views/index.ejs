<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Webb.log</title>
    <link rel="stylesheet" href="/styles/layout.css" />
    <link rel="stylesheet" href="/styles/content.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-danger bg-opacity-25">
    <div class="compact-container">
      <img src="images/logo.png" alt="Logo" />
      <p class="lead">
        Join our endless world of fun, challenges and creativity and start
        b.logging right now.
      </p>
      <form action="/check" method="POST">
        <label for="password">Username:</label></br>
        <input type="text" id="password" name="username" required /><br />
        <label for="password">Password:</label><br />
        <input type="password" id="password" name="password" required /><br />
        <input type="submit" value="Blog!" />
      </form>
      <p>You dont have an account yet?</p>
   <a href="/register" class="btn btn-primary bg-danger bg-opacity-50">Create your account here!</a>
</a>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
